## Example: Full Conversion

### Original Shadertoy

```glsl
void mainImage(out vec4 fragColor, vec2 fragCoord) {
    vec2 uv = fragCoord / iResolution.xy;
    float t = iTime;
    vec3 col = vec3(0);

    for(float i = 0.; i < 10. && length(col) < 1.; i++) {
        col += 0.1 * vec3(sin(t + i), cos(t + i), tanh(i));
    }

    fragColor = vec4(col, 1.0);
}
```

### Converted

```glsl
precision highp float;

uniform float iTime;
uniform vec2 iResolution;

float customTanh(float x) {
    float e2x = exp(2.0 * clamp(x, -10.0, 10.0));
    return (e2x - 1.0) / (e2x + 1.0);
}

void main() {
    vec2 uv = gl_FragCoord.xy / iResolution;
    float t = iTime;
    vec3 col = vec3(0.0);

    for(int i = 0; i < 10; i++) {
        if(length(col) >= 1.0) break;
        float fi = float(i);
        col += 0.1 * vec3(sin(t + fi), cos(t + fi), customTanh(fi));
    }

    gl_FragColor = vec4(col, 1.0);
}
```
